# ============================================
# API KEYS
# ============================================

# NVIDIA API Keys - Get your keys from: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here  # Whisper STT (whisper-large-v3)
NVIDIA_NEMOTRON_API_KEY=your_nvidia_nemotron_api_key_here  # Nemotron Translation (nemotron-3-content-safety)
NVIDIA_API_KEY_LLAMA=your_nvidia_llama_api_key_here  # Llama Models (llama-3.1-8b-instruct, llama-3.1-70b-instruct)
NVIDIA_API_KEY_MISTRAL=your_nvidia_mistral_api_key_here  # NVIDIA Mistral API

# Mistral API Key - Get your key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here  # Knowledge Base Agent (LlamaIndex RAG)

# Groq API Key - Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here  # Groq LLM (llama3-8b-8192)

# OpenAI API Key - Get your key at: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here  # OpenAI GPT-4o-mini (legacy support)

# HuggingFace API Token - Get your token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=your_huggingface_api_token_here  # HuggingFace API for embeddings

# LlamaCloud API Key - Get your key at: https://cloud.llamaindex.ai/
LLAMACLOUD_API_KEY=your_llamacloud_api_key_here  # LlamaParse (PDF table extraction)

# Cohere API Key - Get your key at: https://cohere.com/
COHERE_API_KEY=your_cohere_api_key_here  # Cohere RAG (French/English)

# LangSmith Observability Configuration
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key_here  # Get this from https://smith.langchain.com
LANGCHAIN_PROJECT=bna-multi-agent

# ============================================
# NVIDIA RIVA CONFIGURATION
# ============================================

RIVA_COMMAND_TIMEOUT=180  # Riva gRPC timeout in seconds
RIVA_FUNCTION_ID=b702f636-f60c-4a3d-a6f4-f3568c13bd7d  # Riva function ID for STT
RIVA_FALLBACK_FUNCTION_ID=  # Fallback function ID (optional)

# ============================================
# APP CONFIGURATION
# ============================================

# Voice Model Loading
LOAD_VOICE_MODELS=true  # Enable/disable voice model loading at startup (true/false)

# Whisper Model Selection
WHISPER_MODEL=openai/whisper-tiny  # Whisper model name for STT

# Intent Classifier Configuration
INTENT_CLASSIFIER_PATH=/app/bna_intent_classifier  # Path to trained RoBERTa classifier folder (set automatically in Docker)

# Graph LLM Extraction
ENABLE_GRAPH_LLM_EXTRACTION=0  # Enable graph-based LLM extraction (0/1)
