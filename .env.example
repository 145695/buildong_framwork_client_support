# NVIDIA API Keys
# Get your API keys from: https://build.nvidia.com/

# NVIDIA API Key for Whisper STT (whisper-large-v3)
NVIDIA_API_KEY=your_nvidia_api_key_here

# NVIDIA API Key for Nemotron Translation (nemotron-3-content-safety)
NVIDIA_NEMOTRON_API_KEY=your_nvidia_nemotron_api_key_here

# NVIDIA API Key for Llama Models (llama-3.1-8b-instruct, llama-3.1-70b-instruct)
NVIDIA_API_KEY_LLAMA=your_nvidia_llama_api_key_here

# Mistral API Key for Knowledge Base Agent (LlamaIndex RAG)
# Get your key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# LlamaCloud API Key for LlamaParse (PDF table extraction)
# Get your key at: https://cloud.llamaindex.ai/
# Free tier available without key, but paid tier recommended for production
LLAMACLOUD_API_KEY=your_llamacloud_api_key_here

# Cohere API Key (FREE TIER - Recommended for French/English RAG)
# Get your key at: https://cohere.com/
# Free tier: 1000 API calls/month for Command R + embed-multilingual-v3
COHERE_API_KEY=your_cohere_api_key_here

# LangSmith Observability Configuration
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=        # get this from https://smith.langchain.com
LANGCHAIN_PROJECT=bna-multi-agent

# Intent Classifier Configuration
INTENT_CLASSIFIER_PATH=./bna_intent_classifier  # path to trained RoBERTa classifier folder
