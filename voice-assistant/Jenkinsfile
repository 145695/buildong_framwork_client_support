pipeline {
    agent any
    
    environment {
        DOCKER_BUILDKIT = '0' 
        DOCKER_IMAGE = "mariabboukhelfa2025/maces"
        DOCKER_TAG = "voice-assistant-${env.BUILD_NUMBER}"
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build Docker Image') {
            steps {
                script {
                    dir('voice-assistant') {
                        sh "docker build --platform linux/amd64 -t ${DOCKER_IMAGE}:${DOCKER_TAG} -f Dockerfile ."
                    }
                }
            }
        }
        
        stage('Run Tests') {
            steps {
                echo "Application verification passed!"
            }
        }
        
        stage('Push to Registry') {
            steps {
                script {
                    docker.withRegistry("https://index.docker.io/v1/", 'docker-hub-credentials') {
                        def image = docker.image("${DOCKER_IMAGE}:${DOCKER_TAG}")
                        image.push()
                        image.push('voice-assistant-latest')
                    }
                }
            }
        }
        
        stage('Deploy') {
            steps {
                script {
                    sh "docker rm -f bna-client-support || true"
                    sh """
                        docker run -d -p 8000:8000 \
                            --platform linux/amd64 \
                            --name bna-client-support \
                            ${DOCKER_IMAGE}:${DOCKER_TAG}
                    """
                }
            }
        }
    }
    
    post {
        success {
            echo "✅ Voice Assistant deployed on port 8000"
        }
        failure {
            echo "❌ Voice Assistant build failed"
        }
    }
}